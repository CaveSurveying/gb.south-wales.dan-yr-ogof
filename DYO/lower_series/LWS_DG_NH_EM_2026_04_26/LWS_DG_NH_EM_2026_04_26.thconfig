encoding  utf-8
# Created with SexyTopo 1.11.1 on 2026-04-26


layout local
scale 1 200
  debug off
  symbol-colour line water-flow [0 0 100]
  symbol-colour area water [0 0 100]
  symbol-hide line survey
  symbol-hide point station
  legend on
  symbol-set BCRA
  #colour map-fg altitude
  language en_UK
  map-header -40 100 ne 
  
endlayout


source "LWS_DG_NH_EM_2026_04_26.th"

export map -proj plan -layout local -o "LWS_DG_NH_EM_2026_04_26-plan.pdf"
export map -proj extended -layout local -o "LWS_DG_NH_EM_2026_04_26-ee.pdf"
