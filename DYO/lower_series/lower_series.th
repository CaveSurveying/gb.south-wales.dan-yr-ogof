encoding  utf-8
survey lower_series -title "Lower Series"

input LWS2_2026_04_26/LWS2_2026_04_26.th
input LWS_JW_DW_2026_05_01/LWS_JW_DW_2026_05_01.th
input LWS_2026_04_06/LWS_2026_04_06.th
input LWS_DG_NH_EM_2026_04_26/LWS_DG_NH_EM_2026_04_26.th
input LWS2_JW_DW_2026_05_01/LWS2_JW_DW_2026_05_01.th
input LWS-BB-IN-1_5_2026/LWS-BB-IN-1-5-2026.th
input LWS_TR_JH_2026_05_01/LWS_TR_JH_2026_05_01.th
input LWS_TP_JW_VA_2026_10_31/LWS_TP_JW_VA_2026_10_31.th

### CONNECT CENTRELINE ###

  centreline
    
    equate 11@LWS_2026_04_06 6@LWS2_2026_04_26
    equate 25@LWS_2026_04_06 1@LWS2_2026_04_26
    equate 25@LWS_2026_04_06 1@LWS_JW_DW_2026_05_01
    equate 22@LWS_2026_04_06 1@LWS_DG_NH_EM_2026_04_26
    equate 4@LWS_2026_04_06  1@LWS-BB-IN-1-5-2026
    
    # top join past rope climb
    equate 14@LWS_2026_04_06 1@LWS2_JW_DW_2026_05_01
    
    # bottom join past rope climb
    equate 18@LWS_2026_04_06 8@LWS2_JW_DW_2026_05_01
    
    # water section + water section back to big chamber
    equate 11@LWS_JW_DW_2026_05_01 17@LWS_JW_DW_2026_05_01
  
	equate 15@LWS_DG_NH_EM_2026_04_26 12@LWS_DG_NH_EM_2026_04_26
	  
	equate 1@LWS_TR_JH_2026_05_01 12@LWS_DG_NH_EM_2026_04_26
	  
	equate 53@LWS_TR_JH_2026_05_01 8@LWS_TP_JW_VA_2026_10_31
  endcentreline
  
  ### WALL JOINS ###
  
  
  # join top of rope climb
    join lh1@LWS_2026_04_06:end rh1@LWS2_2026_04_26:end
    join lh2@LWS_2026_04_06:0 rh2@LWS2_2026_04_26:end
  
  # join lower loop at north of chamber at bottom of rope climb
  join lh3@LWS_2026_04_06:end rh1@LWS_JW_DW_2026_05_01:0
  join lh4@LWS_2026_04_06:0 rh2@LWS_JW_DW_2026_05_01:0
  
  # join upper loop at east of chamber at bottom of rope climb
  join lh4@LWS_2026_04_06:end rh3@LWS_JW_DW_2026_05_01:0
  join lh5@LWS_2026_04_06:0  rh4@LWS_JW_DW_2026_05_01:end
  
  # join top of loop west of rope climb
  join lh6@LWS_2026_04_06:end rh1@LWS2_JW_DW_2026_05_01:0
  join lh7@LWS_2026_04_06:end  rh2@LWS2_JW_DW_2026_05_01:end
  
  # join bottom of loop west of rope climb, which links to chamber below
  join lh8@LWS_2026_04_06:end rh3@LWS2_JW_DW_2026_05_01:0
  join lh9@LWS_2026_04_06:end  rh4@LWS2_JW_DW_2026_05_01:end
  
  # join rope climb chamber to virgin passage
  #join lh10@LWS_2026_04_06:0 l120--471--801@LWS_DG_NH_EM_2026_04_26:0
  #join lh11@LWS_2026_04_06:end l69--2373--3709@LWS_DG_NH_EM_2026_04_26:end
  
  # join presumed tube leading west of top of rope climb 
  join lh1@LWS2_JW_DW_2026_05_01:end rh3@LWS2_2026_04_26:end
  join lh2@LWS2_JW_DW_2026_05_01:end rh4@LWS2_2026_04_26:0
 
  
endsurvey

