encoding  utf-8
# Created with SexyTopo 1.11.2 on 2026-05-01

layout local
  scale 1 200
  debug off
  symbol-hide line survey
  symbol-hide point station
  code metapost
  def a_pebbles (expr p) =
      T:=identity;
      pickup PenC;
      path q, qq; q = bbox p;
      picture tmp_pic; 
      tmp_pic := image(
      for i = xpart llcorner q step 0.75u until xpart urcorner q:
        for j = ypart llcorner q step 0.75u until ypart urcorner q:
          qq := (superellipse((.2u,0),(0,.1u),(-.2u,0),(0,.-.1u),.75))
          %  randomized (u/25)
          rotated uniformdeviate(360) 
          shifted ((i,j) randomized 0.4u);
          if xpart (p intersectiontimes qq) < 0:
            thdraw qq;
          fi;
       endfor;  
     endfor;
     );
     clip tmp_pic to p;
     draw tmp_pic;
   enddef;
   endcode
   code metapost
   def a_clay (expr p) =
     T:=identity;
     pickup PenC;
     path q, qq; q = bbox p;
     picture tmp_pic; 
     tmp_pic := image(
     for i = xpart llcorner q step 1.3 u until xpart urcorner q:
       for j = ypart llcorner q step 1.3 u until ypart urcorner q:
         qq := ((-.20u,0){up}..origin{down}..{up}(0.20u,0)) randomized (u/15)
         shifted ((i,j) randomized 0.8u);
         if xpart (p intersectiontimes qq) < 0:
           thdraw qq;
         fi;
       endfor;  
    endfor;
    );
    clip tmp_pic to p;
    draw tmp_pic;
  enddef;
  endcode
endlayout

source "LWS-BB-IN-1-5-2026.th"

#export model -fmt survex -o "LWS-BB-IN-1-5-2026-th.3d"

export map -proj plan -layout local -o "LWS-BB-IN-1-5-2026-plan.pdf"

#export map -proj extended -layout local -o "LWS-BB-IN-1-5-2026-ee.pdf"
